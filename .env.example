# ===========================================
# Takes Two Studio — Environment Variables
# ===========================================
# Copy this file to ".env" on your local machine, or set these
# as Environment Variables in the Hostinger "Deploy Web App" panel.
# -------------------------------------------

# SQLite database path.
# On Hostinger: use an ABSOLUTE path so the DB persists across deploys.
# Find your home path in hPanel → "Advanced" → "Terminal" → run: echo $HOME
# Example: file:/home/u123456789/domains/takestwostudio.com/db/custom.db
DATABASE_URL=file:./db/custom.db

# Admin panel password. Required — the app fails closed if it is missing or
# shorter than 8 characters. Set the real value in the hosting panel only.
ADMIN_PASSWORD=<set-in-hosting-panel>

# Random 32+ byte string used to HMAC-sign session cookies. Required.
# Generate with: openssl rand -hex 32
# Changing it invalidates every existing admin session.
SESSION_SECRET=<set-in-hosting-panel>

# Node environment (Hostinger sets this automatically, but good to have)
NODE_ENV=production
