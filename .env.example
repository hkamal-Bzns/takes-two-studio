# ===========================================
# Takes Two Studio — Environment Variables
# ===========================================
# Copy this file to ".env" on your local machine, or set these
# as Environment Variables in the Hostinger "Deploy Web App" panel.
# -------------------------------------------

# SQLite database path.
# On Hostinger: use an ABSOLUTE path so the DB persists across deploys.
# Find your home path in hPanel → "Advanced" → "Terminal" → run: echo $HOME
# Example: file:/home/u123456789/domains/takestwostudio.com/db/custom.db
DATABASE_URL=file:./db/custom.db

# Admin panel password — change this to something strong!
ADMIN_TOKEN=change-this-to-a-strong-password

# Node environment (Hostinger sets this automatically, but good to have)
NODE_ENV=production
