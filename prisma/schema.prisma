// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  title       String
  category    String   // "advertising" | "food-beverage"
  coverImage  String
  description String?
  order       Int      @default(0)
  published   Boolean  @default(true)
  featured    Boolean  @default(false) // shown in the homepage slideshow
  overview    Boolean  @default(false) // shown on the Overview homepage grid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  images      ProjectImage[]

  @@index([category])
}

model ProjectImage {
  id        String   @id @default(cuid())
  projectId String
  url       String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Inquiry {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  phone     String
  email     String
  message   String
  status    String   @default("new") // "new" | "read" | "archived"
  createdAt DateTime @default(now())

  @@index([status])
}

// Navigation / section visibility — admin can toggle & relabel
model SiteSection {
  id        String   @id @default(cuid())
  key       String   @unique // "overview" | "advertising" | "food-beverage" | "about" | "contact" | "clients"
  label     String   // display name in the nav
  visible   Boolean  @default(true)
  order     Int      @default(0)
}

// Flexible key/value store for global site config
// (hero title/subtitle/tag, logo url, default theme, etc.)
model SiteSetting {
  key       String   @id // e.g. "heroTitle", "heroSubtitle", "heroTag", "logo", "theme"
  value     String
  updatedAt DateTime @updatedAt
}

// Client entries shown on the Clients page
model Client {
  id        String   @id @default(cuid())
  name      String
  logo      String?  // optional logo image URL
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// Curated, ordered images for the Overview homepage grid.
// Each item references any image (project cover or gallery shot) + optional project link.
model OverviewItem {
  id        String   @id @default(cuid())
  url       String
  projectId String?  // optional: links to a Project so the lightbox can offer "view project"
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// Behind-the-scenes (BTS) videos
model Video {
  id          String   @id @default(cuid())
  title       String
  url         String   // Vimeo or YouTube URL (e.g. https://vimeo.com/123, https://youtu.be/abc)
  thumbnail   String?  // optional poster image URL
  description String?
  category    String   @default("bts") // "bts" for behind-the-scenes
  published   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}
