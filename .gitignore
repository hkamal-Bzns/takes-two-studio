# Dependencies
node_modules/

# Next.js build output
.next/
out/

# TypeScript incremental build cache (regenerates on every tsc run)
tsconfig.tsbuildinfo
*.tsbuildinfo

# Database (will be created on the server — do NOT commit your local DB)
db/custom.db
db/custom.db-journal

# Logs
dev.log
server.log
*.log

# Environment
.env
.env.local
.env.production

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Verification screenshots (temp files from dev)
verify-*.png
*-check.png
hero-*.png
final-*.png
imported-*.png
dark-*.png
light-*.png
bar-*.png
no-*.png
overview-*.png
issue-*.png
rebrand-*.png
two-*.png

# Scaffold leftover at the repo root. The leading slash matters: unanchored,
# this pattern also matched src/app/api/upload/ and silently ignored the upload
# API route.
/upload/

# Working notes, audits and one-off patch drafts kept at the repo root.
/IMPLEMENTATION.md
/index-html-patches.md
/picture-patch.md
/takes-two-studio-audit.md
/fix-image-extensions.ts

# Stray artefacts. Both are anchored on purpose: bare `main` would also ignore
# any file or directory named `main` deeper in the tree, and bare `robots.txt`
# would hide public/robots.txt if we ever ship one.
/main
/mnt/
/robots.txt
